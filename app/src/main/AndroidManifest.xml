<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Mapa base: teselas vectoriales de OpenFreeMap/OpenStreetMap -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Ubicación actual: solo se solicita al usar "Mi ubicación" o "Geolocalizar" -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalCash"
        tools:targetApi="31">

        <activity
            android:name="com.localcash.ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CuentasActivity: Vista dummy del Módulo 1 (destino tras login exitoso) -->
        <activity
            android:name="com.localcash.ui.cuentas.CuentasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- RegisterActivity: Pantalla de registro de usuarios (no exportado) -->
        <activity
            android:name="com.localcash.ui.register.RegisterActivity"
            android:exported="false"
            android:parentActivityName="com.localcash.ui.login.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- SeleccionarUbicacionActivity: elige el punto de un movimiento (Feature 009) -->
        <activity
            android:name="com.localcash.ui.mapa.SeleccionarUbicacionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ContactosActivity: agenda de contactos (Feature 011) -->
        <activity
            android:name="com.localcash.ui.contactos.ContactosActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
