<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Light Mode (DayNight) -->
    <style name="Base.Theme.LocalCash" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <!-- Surface colors -->
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <!-- Error colors -->
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <!-- Background -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <!-- Fondo de ventana = fondo de la app: evita el flash negro durante
             recreate() al cambiar de tema o al arrancar la Activity. -->
        <item name="android:windowBackground">@color/md_theme_light_background</item>
        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.HeadlineLarge</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.LabelLarge</item>
        <!-- Shapes -->
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.LargeComponent</item>
        <!-- Status Bar & Navigation Bar: Light mode = dark icons -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <style name="Theme.LocalCash" parent="Base.Theme.LocalCash">
        <!-- Fondo de ventana en el tema que declara el manifiesto. Se resuelve
             contra android:colorBackground del variant activo (claro/oscuro),
             evitando el flash negro al recrear por cambio de tema. -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/md_theme_light_onSurface</item>
        <item name="fontStyle">normal</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/md_theme_light_onSurfaceVariant</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>
</resources>