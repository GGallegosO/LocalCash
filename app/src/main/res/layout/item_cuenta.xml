<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Fila: ícono + nombre + monto de la cuenta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivIconoCuenta"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/aCuentas_item_cuenta_icon_desc"
            app:tint="?attr/colorOnSurface"
            tools:src="@drawable/ic_account_balance_wallet" />

        <TextView
            android:id="@+id/tvNombreCuenta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="Nombre" />

        <TextView
            android:id="@+id/tvMontoCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:text="$0" />

    </LinearLayout>

    <!-- Divisor entre filas (recuado para alinearse bajo el ícono) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="64dp"
        android:background="?attr/colorOutlineVariant" />

</LinearLayout>
