<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView raíz para permitir scroll en pantallas pequeñas (Small Phone).
     fillViewport="true" hace que el contenido interno ocupe al menos la altura del ScrollView. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context="com.localcash.ui.register.RegisterActivity">

    <!-- ConstraintLayout contenedor interno: apila verticalmente el botón de tema y la CardView.
         layout_height="wrap_content" para que el ScrollView mida su altura real. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Toggle Button mode (igual que LoginActivity) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeToggle"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/aRegister_theme_toggle_desc"
            app:icon="@drawable/ic_brightness_medium"
            app:iconTint="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- MaterialCardView del formulario de registro -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRegister"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="48dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardElevation="4dp"
            app:cardCornerRadius="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnThemeToggle">

            <!-- LinearLayout interno con padding 32dp: logo, título, ViewFlipper, footer. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:orientation="vertical"
                android:padding="32dp">

                <!-- Logo oficial -->
                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/aRegister_logo_desc"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher" />

                <!-- Título principal: "Crear Cuenta" (HeadlineLarge, bold) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:text="@string/aRegister_title"
                    android:textAppearance="?attr/textAppearanceHeadlineLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <!-- ViewFlipper: alterna entre las 3 vistas del registro -->
                <ViewFlipper
                    android:id="@+id/viewFlipper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Vista 1/3: Región y Ciudad -->
                    <include
                        android:id="@+id/step1"
                        layout="@layout/view_register_step1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Vista 2/3: Usuario y Contraseña -->
                    <include
                        android:id="@+id/step2"
                        layout="@layout/view_register_step2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Vista 3/3: Confirmación -->
                    <include
                        android:id="@+id/step3"
                        layout="@layout/view_register_step3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </ViewFlipper>

                <!-- Footer: ícono seguridad + texto "100% Offline y Privado" -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/aRegister_footer_privacy"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:drawableStartCompat="@drawable/ic_security"
                    app:drawableTint="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
