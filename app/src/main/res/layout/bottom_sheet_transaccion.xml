<?xml version="1.0" encoding="utf-8"?>
<!-- BottomSheet para registrar un movimiento (Feature 008).
     Reutiliza los strings, la validación de UI y la lógica de dominio del
     formulario de transacción. Mismas reglas de estilo: cero colores/textos
     hardcodeados (solo ?attr/... y @string/...) y atributos Material 3. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- Título del BottomSheet -->
        <TextView
            android:id="@+id/tvTituloTransaccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/aCuentas_transaccion_titulo"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <!-- Toggle segmentado Ingreso / Egreso -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTipoTransaccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIngreso"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/aCuentas_transaccion_ingreso" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEgreso"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/aCuentas_transaccion_egreso" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Monto del movimiento -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutMonto"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/aCuentas_transaccion_monto_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputMonto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                tools:text="50000" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Selector de cuenta: dropdown Material 3 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutCuenta"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/aCuentas_transaccion_cuenta_hint">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/spinnerCuentas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                tools:text="Cuenta Corriente" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Concepto con sugerencias predefinidas (editable: permite escribir otro) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutConcepto"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/aCuentas_transaccion_concepto_hint">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/inputConcepto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                tools:text="Supermercado" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Gasto compartido (Feature 012): solo aplica a egresos. El bloque de
             división permanece oculto hasta que el usuario marca el checkbox.
             Todos los cálculos de reparto los hace el ViewModel con
             GastoCompartidoService; esta vista solo orquesta. -->
        <CheckBox
            android:id="@+id/chkCompartido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/aGastoCompartido_compartido" />

        <LinearLayout
            android:id="@+id/layoutDivision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvTituloContactos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aGastoCompartido_contactos_titulo"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- CheckBox por contacto de la agenda, añadido en código -->
            <LinearLayout
                android:id="@+id/contenedorContactos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvSinContactos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/aGastoCompartido_sin_contactos"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:visibility="visible" />

            <RadioGroup
                android:id="@+id/rgModoDivision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbIgual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/aGastoCompartido_modo_igual" />

                <RadioButton
                    android:id="@+id/rbPersonalizado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/aGastoCompartido_modo_personalizado" />

            </RadioGroup>

            <!-- Fila por contacto con monto editable (modo personalizado) -->
            <LinearLayout
                android:id="@+id/contenedorPartes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvSumaEnVivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="Suma de las partes: 100.000 de 100.000" />

        </LinearLayout>

        <!-- Geolocalización: el interruptor abre el mapa de selección (Feature 009) -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchGeolocalizacion"            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/aCuentas_transaccion_geolocalizacion" />

        <TextView
            android:id="@+id/tvUbicacionSeleccionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:text="Ubicación: -33.44890, -70.66930"
            tools:visibility="visible" />

        <!-- Guardar movimiento -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarMovimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/aCuentas_transaccion_guardar" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
