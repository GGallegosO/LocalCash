<?xml version="1.0" encoding="utf-8"?>
<!--
  Placeholder de la Activity de detalle de un lugar de compra (Feature 010,
  Fase 3). La lista editable completa se implementa en la Fase 4.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDetalleLugar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/detalle_lugar_titulo_barra"
        app:titleTextColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tvDetalleLugar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

</LinearLayout>
