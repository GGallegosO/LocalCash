<?xml version="1.0" encoding="utf-8"?>
<!-- Vista paso 2/3 del registro: Usuario y Contraseña. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Indicador de progreso: barra 2 de 3 -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressStep2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:max="3"
        android:progress="2"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <!-- Etiqueta de progreso: "Paso 2 de 3" -->
    <TextView
        android:id="@+id/tvProgressStep2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="@string/aRegister_step_2"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Subtítulo del paso -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="@string/aRegister_credentials_subtitle"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:gravity="center" />

    <!-- Campo usuario -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRegisterUsername"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="@string/aRegister_hint_username"
        app:startIconDrawable="@drawable/ic_person"
        app:startIconContentDescription="@string/aRegister_input_user_desc">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRegisterUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Campo contraseña con toggle de visibilidad integrado (como Login) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRegisterPassword"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="@string/aRegister_hint_password"
        app:endIconMode="password_toggle"
        app:endIconContentDescription="@string/aRegister_password_toggle_desc"
        app:startIconDrawable="@drawable/ic_lock"
        app:startIconContentDescription="@string/aRegister_input_password_desc">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRegisterPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- TextView para mensajes de error (inicialmente GONE) -->
    <TextView
        android:id="@+id/tvMessageStep2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <!-- Botones horizontales: Atrás / Continuar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Botón "Atrás" (Outlined, 45% del ancho) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStep2Back"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/aRegister_btn_back"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <!-- Botón "Continuar" (Filled, 55% del ancho) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStep2Next"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1.5"
            android:text="@string/aRegister_btn_next"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

    </LinearLayout>

</LinearLayout>
