<?xml version="1.0" encoding="utf-8"?>
<!--
  Mini-diálogo para agregar un tipo de lugar personalizado (Feature 010, Fase 2.5).
  Se infla con ViewBinding (DialogAgregarTipoLugarBinding).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutNuevoTipo"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/dialog_agregar_tipo_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputNuevoTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapWords" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
