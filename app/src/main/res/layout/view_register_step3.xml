<?xml version="1.0" encoding="utf-8"?>
<!-- Vista paso 3/3 del registro: Confirmación final. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Indicador de progreso: barra 3 de 3 -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressStep3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:max="3"
        android:progress="3"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <!-- Etiqueta de progreso: "Paso 3 de 3" -->
    <TextView
        android:id="@+id/tvProgressStep3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="@string/aRegister_step_3"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Icono de confirmación -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/aRegister_confirm_desc"
        android:src="@drawable/ic_security"
        app:tint="?attr/colorPrimary" />

    <!-- Texto de confirmación principal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/aRegister_confirm_question"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold" />

    <!-- Texto secundario de confirmación -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/aRegister_confirm_subtitle"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Resumen de datos (username) -->
    <TextView
        android:id="@+id/tvConfirmSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone" />

    <!-- TextView para mensajes de error (inicialmente GONE) -->
    <TextView
        android:id="@+id/tvMessageStep3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <!-- Botones horizontales: Cancelar / Finalizar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Botón "Cancelar" (Outlined, 45% del ancho) - vuelve a Login -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStep3Cancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/aRegister_btn_cancel"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <!-- Botón "Finalizar" (Filled, 55% del ancho) - guarda y registra -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStep3Finish"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1.5"
            android:text="@string/aRegister_btn_finish"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

    </LinearLayout>

</LinearLayout>
