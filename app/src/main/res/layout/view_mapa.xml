<?xml version="1.0" encoding="utf-8"?>
<!--
  Vista 2 (Mapa): modo lectura de los movimientos geolocalizados
  (Feature 009, T10-T12).

  Contiene el MapView de osmdroid (con sus controles de zoom nativos) y la
  atribución obligatoria de OpenStreetMap. La Activity
  (CuentasActivity) es quien conecta el MapView al TileSource local
  (TeselasLocales, offline) y dibuja un pin por movimiento geolocalizado a
  través de MapaLecturaController.

  Reglas de estilo del proyecto: cero colores y cero textos hardcodeados
  (solo ?attr/... y @string/...).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      MapView de osmdroid. Su TileSource se fija por código (TeselasLocales):
      teselas preempaquetadas en assets/, sin red. Hasta que T0 empaquete las
      teselas se verá un lienzo navegable vacío (no un error).
    -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapaLectura"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Atribución obligatoria de OpenStreetMap (esquina inferior izquierda) -->
    <TextView
        android:id="@+id/tvAtribucionOsm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/colorSurface"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="@string/mapa_atribucion_osm"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/mapaLectura"
        app:layout_constraintStart_toStartOf="@id/mapaLectura" />

</androidx.constraintlayout.widget.ConstraintLayout>
